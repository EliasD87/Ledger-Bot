# Copy to .env and fill in. Never commit .env.

# --- Discord ---
# The bot token is all Ledger needs. It finds its own application ID, registers its slash
# commands in every server it's in, and logs an invite link on startup.
DISCORD_TOKEN=
# Optional: comma-separated channel IDs Ledger answers mentions in. Empty = everywhere it can read.
ALLOWED_CHANNEL_IDS=

# --- DeepSeek (https://platform.deepseek.com) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# USD per 1M tokens, used only to track spend. Defaults are deepseek-flash PEAK prices
# (off-peak is half), so tracked spend is an upper bound.
DEEPSEEK_PRICE_INPUT_HIT=0.006
DEEPSEEK_PRICE_INPUT_MISS=0.30
DEEPSEEK_PRICE_OUTPUT=1.20

# --- Cost guards ---
# The daily cap protects the DeepSeek credit from bugs and surprises; keep it on.
LLM_DAILY_BUDGET_USD=2.00
LLM_MAX_REPLY_TOKENS=700
# Per-user limits. 0 = off (the server is a closed group). Turn on if it opens to the public.
USER_COOLDOWN_SECONDS=0
USER_HOURLY_LIMIT=0
# How many messages of a reply chain Ledger reads for context.
THREAD_MAX_MESSAGES=12

# --- SoSoValue (https://sosovalue.com/developer) ---
# Powers the tape (ETF flows, corporate BTC buys, macro calendar, news, market overview) and
# ETF-flow takes. Only a background fetcher calls it, inside the monthly cap. Optional.
SOSOVALUE_API_KEY=

# --- Market data ---
# Binance public market-data host. Use https://api.binance.com if this one is unreachable.
PRICE_FEED_URL=https://data-api.binance.vision

# --- Storage ---
DB_PATH=./data/ledger.db

# debug | info | warn | error
LOG_LEVEL=info
